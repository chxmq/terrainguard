# Copy to .env:  cp .env.example .env
# Nothing below is required for normal use (default = SRTM tiles, no key).

# --- OpenTopography only (optional) ---
# TTCI_SOURCE=opentopo
# OPENTOPO_API_KEY=paste_your_key_here

# --- Demo preload (optional — or use: make demo-preload) ---
# TTCI_PRELOAD=1
# TTCI_BBOX=33.8,34.5,76.8,77.8
# TTCI_ZOOM=11
# TTCI_SOURCE=tiles
