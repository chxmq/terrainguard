# Optional backend configuration (copy to .env and uncomment as needed)

# Preload a TTCI region at startup (otherwise user selects on the map)
# TTCI_PRELOAD=1
# TTCI_BBOX=33.8,34.5,76.8,77.8
# TTCI_ZOOM=11
# TTCI_SOURCE=tiles

# Force synthetic demo DEM instead of real terrain
# TTCI_SYNTHETIC=1

# Required when TTCI_SOURCE=opentopo
# OPENTOPO_API_KEY=
