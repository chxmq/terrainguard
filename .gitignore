# ──────────────────────────────────────────────────────────────────────────────
# Terrain Guard — repository ignore rules
# Monorepo: backend/ (Python / FastAPI)  ·  frontend/ (Vite + React + TS)
# ──────────────────────────────────────────────────────────────────────────────

# ── Secrets & local environment ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.local
secrets.*
*.pem
*.key

# ══════════════════════════════════════════════════════════════════════════════
# Python (backend)
# ══════════════════════════════════════════════════════════════════════════════

# Bytecode & C extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
backend/venv/
backend/.venv/

# Packaging / build artifacts
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
.installed.cfg
*.manifest
*.spec

# Test, coverage & type-check caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.pytype/
.ruff_cache/
.dmypy.json
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Jupyter / IPython
.ipynb_checkpoints/
profile_default/

# ══════════════════════════════════════════════════════════════════════════════
# Node / Vite / TypeScript (frontend)
# ══════════════════════════════════════════════════════════════════════════════

node_modules/
frontend/dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Optional caches
.eslintcache
.cache/

# ══════════════════════════════════════════════════════════════════════════════
# Generated TTCI data products  (recomputed on demand — outputs, not sources)
# ══════════════════════════════════════════════════════════════════════════════

backend/data/*.tif
backend/data/*.png
backend/data/*.json
backend/data/tiles/
backend/data/**/*.tif
backend/data/**/*.png
# Keep the data directory in version control even when empty.
!backend/data/.gitkeep

# ── Local-only docs (pitch / demo notes, not for the public repo) ──────────────
docs/

# ══════════════════════════════════════════════════════════════════════════════
# Editors / IDEs
# ══════════════════════════════════════════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ══════════════════════════════════════════════════════════════════════════════
# OS cruft
# ══════════════════════════════════════════════════════════════════════════════
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
